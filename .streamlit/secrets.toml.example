# Copie este arquivo para .streamlit/secrets.toml e preencha os valores.
# .streamlit/ está no .gitignore — o secrets.toml real NUNCA vai para o repositório.
#
# No Streamlit Cloud, cole o mesmo conteúdo em:
#   app -> (menu ...) -> Settings -> Secrets

# Hash SHA256 da senha de acesso. Gere com:  python gerar_senha.py
SENHA_HASH = "cole_aqui_o_hash_sha256_da_sua_senha"

# Token do GitHub usado para persistir dados_dashboard_ana.json no repositório.
GITHUB_TOKEN = "ghp_cole_aqui_seu_token"
